{
  "Settings": {
    "DownloadsPath": "%USERPROFILE%\\Downloads",
    "CreateLogs": true,
    "MoveUnknownFiles": true,
    "Overwrite": false,
    "EnableSmartRules": true,
    "CreateCategoryFolders": true,
    "Verbose": false,
    "DryRun": false,
    "Recursive": false,
    "IgnorePatterns": [ "*.tmp", "*.crdownload", "desktop.ini", ".DS_Store", "*.part" ],
    "MinAgeDays": 0,
    "MaxAgeDays": 0,
    "MinSizeBytes": 0,
    "MaxSizeBytes": 0,
    "WatcherDebounceSeconds": 3,
    "ScheduleIntervalMinutes": 60,
    "ExportCSV": false,
    "ExportJSON": false,
    "ExportHTML": false
  },

  "Categories": {
    "Applications": ["exe", "msi", "msix", "appx"],

    "Archives": ["zip", "rar", "7z", "tar", "gz"],

    "Documents": [
      "pdf",
      "doc",
      "docx",
      "xls",
      "xlsx",
      "ppt",
      "pptx",
      "txt",
      "csv",
      "md"
    ],

    "Images": ["jpg", "jpeg", "png", "gif", "bmp", "webp", "svg"],

    "Videos": ["mp4", "avi", "mov", "mkv", "webm"],

    "Audio": ["mp3", "wav", "aac", "m4a", "flac"],

    "Code": [
      "ps1",
      "psm1",
      "js",
      "ts",
      "jsx",
      "tsx",
      "html",
      "css",
      "json",
      "xml",
      "yaml",
      "yml",
      "sql",
      "py",
      "java",
      "cpp",
      "cs"
    ],

    "Fonts": ["ttf", "otf", "woff", "woff2"],

    "Others": []
  },

  "SmartRules": {
    "Documents": {
      "CV": {
        "Priority": 100,
        "Keywords": ["cv", "resume", "curriculum", "portfolio"]
      },

      "Finance": {
        "Priority": 90,
        "Keywords": [
          "invoice",
          "receipt",
          "payment",
          "billing",
          "transaction",
          "bank",
          "tokopedia",
          "shopee"
        ]
      },

      "Academic": {
        "Priority": 80,
        "Keywords": [
          "skripsi",
          "thesis",
          "journal",
          "paper",
          "research",
          "proposal"
        ]
      },

      "Certificates": {
        "Priority": 70,
        "Keywords": ["certificate", "sertifikat", "credential", "award"]
      }
    },

    "Archives": {
      "Projects": {
        "Priority": 100,
        "Keywords": ["project", "source", "repository", "github", "backup"]
      }
    },

    "Images": {
      "Screenshots": {
        "Priority": 50,
        "Keywords": ["screenshot", "screen", "capture"]
      },

      "Wallpapers": {
        "Priority": 40,
        "Keywords": ["wallpaper", "background"]
      }
    }
  }
}
